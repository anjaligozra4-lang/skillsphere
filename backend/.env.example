APP_NAME=SkillSphere
APP_ENV=development
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=skillsphere
MYSQL_PASSWORD=change-me
MYSQL_DATABASE=skillsphere_db
CORS_ORIGINS=http://localhost:5174,http://127.0.0.1:5174
JWT_SECRET_KEY=generate-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7
ADMIN_EMAIL=admin@skillsphere.com
ADMIN_PASSWORD=
ADMIN_FULL_NAME=SkillSphere Administrator

# OTP Security
OTP_EXPIRE_MINUTES=5
OTP_RESEND_COOLDOWN_SECONDS=30
OTP_MAX_ATTEMPTS=5

# SMTP Email Configuration (Required for OTP & Assessment Invitations)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=SkillSphere
SMTP_USE_TLS=true
SMTP_USE_SSL=false

# Frontend URL & Assessment Configuration
FRONTEND_BASE_URL=http://localhost:5174
ASSESSMENT_DURATION_MINUTES=30
ASSESSMENT_LINK_EXPIRE_HOURS=72
AUTO_SHORTLIST_THRESHOLD=70.0

# Optional External AI Provider (openai or gemini; leaves built-in skill engine active when empty)
AI_PROVIDER=none
AI_API_KEY=
AI_MODEL=
AI_REQUIRE_EXTERNAL=false

# Database URL Override (PostgreSQL / MySQL / SQLite)
DATABASE_URL=

# Cloudinary Media Storage (Single destination for all assessment & interview recordings)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# LiveKit Real-Time Communication & Server-side Egress
LIVEKIT_URL=http://127.0.0.1:7880
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_EGRESS_STAGING_DIR=
