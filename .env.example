APP_NAME=SkillSphere
APP_ENV=development
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8001
CORS_ORIGINS=http://localhost:5174,http://127.0.0.1:5174

MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=skillsphere
MYSQL_PASSWORD=change-me
MYSQL_DATABASE=skillsphere_db

JWT_SECRET_KEY=generate-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Database URL Override (PostgreSQL / MySQL / SQLite)
DATABASE_URL=

# Cloudinary Media Storage (Single destination for all assessment & interview recordings)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# LiveKit Real-Time Communication & Server-side Egress
LIVEKIT_URL=http://127.0.0.1:7880
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

