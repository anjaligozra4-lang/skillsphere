:root {
  font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
  color: #172033;
  background: #f8fafc;
  font-synthesis: none;
}

* {
  box-sizing: border-box;
}

body {
  margin: 0;
  min-width: 320px;
  min-height: 100vh;
}

a {
  color: inherit;
  text-decoration: none;
}

.navbar {
  height: 72px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 5vw;
  background: rgba(255, 255, 255, 0.96);
  border-bottom: 1px solid #e5e7eb;
  position: relative;
  z-index: 10;
}

.brand {
  color: #4338ca;
  font-size: 1.35rem;
  font-weight: 800;
}

.nav-links,
.hero-actions {
  display: flex;
  align-items: center;
  gap: 18px;
}

.hero {
  min-height: calc(100vh - 72px);
  display: grid;
  grid-template-columns: minmax(0, 1fr) minmax(280px, 430px);
  align-items: center;
  gap: 8vw;
  padding: 72px 8vw;
  background:
    radial-gradient(circle at 82% 18%, rgba(99, 102, 241, 0.22), transparent 28%),
    radial-gradient(circle at 10% 90%, rgba(14, 165, 233, 0.12), transparent 24%),
    linear-gradient(135deg, #ffffff 0%, #f5f7ff 58%, #eef2ff 100%);
  position: relative;
  overflow: hidden;
}

.hero::before {
  content: "";
  position: absolute;
  width: 320px;
  height: 320px;
  left: -190px;
  top: 16%;
  border: 1px solid rgba(79, 70, 229, 0.16);
  border-radius: 50%;
  box-shadow: 0 0 0 55px rgba(79, 70, 229, 0.025), 0 0 0 110px rgba(79, 70, 229, 0.018);
}

.hero-copy {
  position: relative;
  z-index: 1;
}

.hero h1 {
  max-width: 700px;
  margin: 14px 0;
  font-size: clamp(2.7rem, 6vw, 5.8rem);
  line-height: 0.98;
  letter-spacing: -0.055em;
  color: #111827;
}

.hero p {
  max-width: 620px;
  color: #4b5563;
  font-size: 1.15rem;
  line-height: 1.7;
}

.eyebrow {
  color: #4f46e5;
  font-weight: 800;
  letter-spacing: 0.09em;
  text-transform: uppercase;
}

.button {
  display: inline-flex;
  justify-content: center;
  padding: 13px 20px;
  border-radius: 10px;
  color: white;
  background: #4f46e5;
  font-weight: 700;
  border: 0;
  cursor: pointer;
}

.button-small {
  padding: 10px 16px;
}

.button-secondary {
  color: #3730a3;
  background: white;
  border: 1px solid #c7d2fe;
}

.hero-card {
  display: grid;
  gap: 10px;
  padding: 34px;
  border-radius: 24px;
  background: #172033;
  box-shadow: 0 24px 60px rgba(23, 32, 51, 0.2);
  color: white;
  position: relative;
  z-index: 1;
  transform: rotate(1deg);
}

.hero-card strong {
  margin-top: 18px;
  font-size: 1.35rem;
}

.hero-card span {
  color: #c7d2fe;
}

.hero-card-header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  padding-bottom: 16px;
  border-bottom: 1px solid rgba(255, 255, 255, 0.12);
}

.hero-card-header strong {
  color: #a5b4fc;
  font-size: 2rem;
}

.match-track {
  height: 7px;
  margin-bottom: 16px;
  border-radius: 999px;
  overflow: hidden;
  background: rgba(255, 255, 255, 0.12);
}

.match-track span {
  display: block;
  width: 92%;
  height: 100%;
  background: linear-gradient(90deg, #818cf8, #c4b5fd);
}

.feature-row {
  display: grid;
  grid-template-columns: 44px 1fr;
  align-items: center;
  gap: 14px;
  padding-top: 18px;
}

.feature-row > div:last-child {
  display: grid;
  gap: 4px;
}

.feature-row strong,
.feature-row span {
  margin: 0;
}

.feature-icon {
  display: grid;
  width: 44px;
  height: 44px;
  place-items: center;
  border-radius: 12px;
  background: rgba(129, 140, 248, 0.16);
  color: #c7d2fe;
  font-size: 0.78rem;
  font-weight: 800;
}

.button {
  transition: transform 160ms ease, box-shadow 160ms ease, background-color 160ms ease;
}

.button:hover:not(:disabled) {
  transform: translateY(-2px);
  box-shadow: 0 10px 24px rgba(79, 70, 229, 0.22);
}

.placeholder-page {
  width: min(900px, 90%);
  margin: 80px auto;
  padding: 48px;
  border-radius: 18px;
  background: white;
  box-shadow: 0 12px 40px rgba(15, 23, 42, 0.08);
}

input, textarea, select {
  width: 100%;
  padding: 13px 14px;
  border: 1px solid #d1d5db;
  border-radius: 9px;
  font: inherit;
  background: white;
}

textarea {
  min-height: 110px;
  resize: vertical;
}

.button:disabled {
  cursor: not-allowed;
  opacity: 0.65;
}

.profile-form-panel {
  grid-column: 1 / -1;
}

.profile-form {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 14px;
}

.profile-form .full-width {
  grid-column: 1 / -1;
}

.resume-upload {
  display: grid;
  gap: 12px;
  margin-bottom: 18px;
}

.card-actions {
  display: flex;
  flex-wrap: wrap;
  gap: 10px;
}

.resume-row {
  display: grid;
  gap: 8px;
  padding: 14px 0;
  border-bottom: 1px solid #e5e7eb;
}

.resume-row span {
  color: #64748b;
}

.text-button {
  display: block;
  padding: 4px 0;
  border: 0;
  color: #4f46e5;
  background: transparent;
  cursor: pointer;
  font-weight: 700;
}

.auth-page {
  min-height: calc(100vh - 72px);
  display: grid;
  place-items: center;
  padding: 40px 20px;
  background:
    radial-gradient(circle at 15% 20%, rgba(129, 140, 248, 0.14), transparent 28%),
    linear-gradient(135deg, #f8fafc 0%, #eef2ff 100%);
}

.panel {
  border-radius: 18px;
  background: white;
  box-shadow: 0 18px 50px rgba(15, 23, 42, 0.09);
}

.auth-shell {
  width: min(980px, 100%);
  min-height: 590px;
  display: grid;
  grid-template-columns: 0.95fr 1.05fr;
  overflow: hidden;
  border: 1px solid rgba(226, 232, 240, 0.85);
  border-radius: 28px;
  background: white;
  box-shadow: 0 28px 80px rgba(30, 41, 59, 0.16);
}

.auth-brand-panel {
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  padding: 44px;
  overflow: hidden;
  color: white;
  background:
    radial-gradient(circle at 85% 8%, rgba(165, 180, 252, 0.32), transparent 26%),
    linear-gradient(145deg, #312e81, #4f46e5 55%, #7c3aed);
  position: relative;
}

.auth-brand-panel::after {
  content: "";
  position: absolute;
  width: 260px;
  height: 260px;
  right: -145px;
  bottom: -120px;
  border: 1px solid rgba(255, 255, 255, 0.14);
  border-radius: 50%;
  box-shadow: 0 0 0 42px rgba(255, 255, 255, 0.035), 0 0 0 84px rgba(255, 255, 255, 0.025);
}

.auth-brand {
  width: fit-content;
  color: white;
  font-size: 1.35rem;
  font-weight: 850;
}

.auth-kicker {
  display: block;
  margin-bottom: 14px;
  color: #c7d2fe;
  font-size: 0.78rem;
  font-weight: 800;
  letter-spacing: 0.12em;
  text-transform: uppercase;
}

.auth-brand-panel h2 {
  max-width: 420px;
  margin: 0 0 18px;
  font-size: clamp(2rem, 4vw, 3.15rem);
  line-height: 1.04;
  letter-spacing: -0.045em;
}

.auth-brand-panel p {
  max-width: 420px;
  color: #e0e7ff;
  line-height: 1.75;
}

.auth-trust {
  display: flex;
  gap: 22px;
  color: #c7d2fe;
  font-size: 0.78rem;
  position: relative;
  z-index: 1;
}

.auth-trust span {
  display: grid;
  gap: 3px;
}

.auth-trust strong {
  color: white;
  font-size: 0.95rem;
}

.auth-card {
  display: grid;
  align-content: center;
  gap: 16px;
  padding: 54px 64px;
}

.auth-card h1 {
  margin: 4px 0 6px;
  font-size: 2.35rem;
}

.auth-card > a {
  color: #4f46e5;
  text-align: center;
  font-size: 0.92rem;
  font-weight: 700;
}

.password-field {
  position: relative;
}

.password-field input {
  padding-right: 66px;
}

.password-toggle {
  position: absolute;
  right: 10px;
  top: 50%;
  border: 0;
  color: #4f46e5;
  background: transparent;
  transform: translateY(-50%);
  cursor: pointer;
  font-weight: 800;
}

.forgot-password-row {
  display: flex;
  justify-content: flex-end;
  margin-top: -8px;
}

.reset-help {
  margin: 0;
  padding: 12px;
  border-radius: 9px;
  color: #475569;
  background: #f1f5f9;
  font-size: 0.88rem;
  line-height: 1.5;
}

.match-result {
  margin-bottom: 20px;
  padding: 18px;
}

.match-history {
  margin-bottom: 24px;
  padding: 22px;
}

.match-history h2 {
  margin-top: 0;
}

.match-history-row {
  display: grid;
  grid-template-columns: minmax(180px, 1fr) auto;
  gap: 6px 16px;
  padding: 14px 0;
  border-top: 1px solid #e5e7eb;
}

.match-history-row a {
  color: #3730a3;
  font-weight: 700;
}

.match-history-row span {
  grid-column: 1 / -1;
  color: #64748b;
}

.pagination {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 18px;
  margin-top: 24px;
}

.pagination span {
  color: #475569;
  font-weight: 700;
}

.back-link {
  display: inline-block;
  margin-bottom: 18px;
  color: #4338ca;
  font-weight: 700;
}

.job-detail {
  display: grid;
  gap: 18px;
  padding: clamp(24px, 5vw, 48px);
}

.job-detail h1 {
  margin: 0;
  font-size: clamp(2rem, 5vw, 3.5rem);
}

.job-detail h2 {
  margin: 10px 0 0;
}

.job-detail-company {
  margin: 0;
  color: #64748b;
  font-size: 1.1rem;
}

.job-facts {
  display: flex;
  flex-wrap: wrap;
  gap: 10px;
}

.job-facts span {
  padding: 9px 12px;
  border-radius: 9px;
  background: #eef2ff;
  color: #3730a3;
  font-weight: 700;
}

.job-description {
  white-space: pre-wrap;
  line-height: 1.75;
}

.resume-page-text {
  margin-top: 12px;
}

.resume-page-text pre {
  max-height: 240px;
  overflow: auto;
  padding: 12px;
  border-radius: 8px;
  background: #f8fafc;
  white-space: pre-wrap;
}

.resume-error {
  color: #b91c1c !important;
}

.empty-state {
  grid-column: 1 / -1;
  padding: 42px;
  text-align: center;
  animation: empty-state-in 520ms cubic-bezier(0.2, 0.75, 0.25, 1) both;
}

.empty-state::before {
  content: "⌕";
  display: grid;
  width: 64px;
  height: 64px;
  place-items: center;
  margin: 0 auto 20px;
  border: 1px solid #e0e7ff;
  border-radius: 50%;
  color: #4f46e5;
  background: radial-gradient(circle at 35% 30%, #fff, #e0e7ff 78%);
  box-shadow: 0 10px 24px rgba(79, 70, 229, 0.12);
  font-size: 2.5rem;
  line-height: 1;
  animation: empty-icon-float 3s 500ms ease-in-out infinite;
}

.empty-state h2 {
  margin-top: 0;
}

.empty-state p {
  margin-bottom: 0;
  color: #64748b;
  line-height: 1.6;
}

.resume-selector {
  display: grid;
  gap: 8px;
  margin-bottom: 20px;
  padding: 14px 16px;
  border-radius: 12px;
  background: white;
  box-shadow: 0 8px 24px rgba(15, 23, 42, 0.06);
  color: #475569;
  font-size: 0.88rem;
  font-weight: 700;
}

.job-select {
  width: 100%;
  display: grid;
  gap: 4px;
  margin-bottom: 10px;
  padding: 12px;
  border: 1px solid #e5e7eb;
  border-radius: 10px;
  background: white;
  text-align: left;
}

.job-select span {
  color: #64748b;
  font-size: 0.85rem;
}

.applicant-row {
  display: grid;
  grid-template-columns: 1fr 160px;
  align-items: center;
  gap: 12px;
  padding: 12px 0;
  border-bottom: 1px solid #e5e7eb;
}

.applicant-row details {
  margin-top: 8px;
  color: #64748b;
}

.applicant-row summary {
  color: #4338ca;
  cursor: pointer;
  font-weight: 700;
}

.applicant-filters {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));
  gap: 10px;
  margin-bottom: 16px;
}

.application-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
  padding: 10px 0;
  border-bottom: 1px solid #e5e7eb;
}

.application-row p {
  margin: 0;
}

.resume-review-form {
  margin-top: 10px;
  padding: 14px;
  border-radius: 10px;
  background: #f8fafc;
}

.stats-grid {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 14px;
}

.stat-card {
  display: grid;
  gap: 4px;
  padding: 18px;
  border-radius: 12px;
  background: #eef2ff;
  text-align: center;
}

.stat-card strong {
  color: #4338ca;
  font-size: 1.7rem;
}

.stat-card span,
.admin-row span {
  color: #64748b;
  text-transform: capitalize;
}

.admin-row {
  display: grid;
  grid-template-columns: 1fr auto;
  align-items: center;
  gap: 12px;
  padding: 14px 0;
  border-bottom: 1px solid #e5e7eb;
}

.admin-row div {
  display: grid;
  gap: 4px;
}

.admin-row select {
  width: 150px;
}

.page-content {
  width: min(1120px, 92%);
  margin: 50px auto;
}

.loading-message {
  margin: 0 0 18px;
  padding: 14px 16px;
  border-radius: 10px;
  color: #3730a3;
  background: #eef2ff;
  font-weight: 700;
}

.page-heading {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 20px;
  margin-bottom: 24px;
}

.page-heading h1 {
  margin: 8px 0 0;
  font-size: clamp(2rem, 4vw, 3rem);
  letter-spacing: -0.035em;
}

.search-bar {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
  gap: 12px;
  margin-bottom: 24px;
}

.search-bar input {
  height: 48px;
}

.search-bar .button {
  height: 48px;
  min-width: 120px;
}

.job-grid,
.dashboard-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
  gap: 20px;
}

.job-card {
  display: grid;
  align-content: start;
  gap: 12px;
  padding: 24px;
}

.job-card h2 {
  margin: 0;
}

.job-card p {
  margin: 0;
  color: #64748b;
  line-height: 1.6;
}

.status {
  width: fit-content;
  padding: 5px 9px;
  border-radius: 999px;
  background: #e0e7ff;
  color: #3730a3;
  font-size: 0.75rem;
  text-transform: capitalize;
}

.chips {
  display: flex;
  flex-wrap: wrap;
  gap: 6px;
}

.chips span {
  padding: 5px 8px;
  border-radius: 7px;
  background: #f1f5f9;
  font-size: 0.82rem;
}

.dashboard-grid section {
  padding: 28px;
}

.error,
.info-message {
  padding: 12px 14px;
  border-radius: 9px;
  color: #b91c1c;
  background: #fff1f2;
}

.info-message:not(.error) {
  margin-bottom: 18px;
  color: #3730a3;
  background: #eef2ff;
}

.panel {
  border: 1px solid rgba(226, 232, 240, 0.8);
}

.navbar {
  animation: slide-down 520ms cubic-bezier(0.2, 0.75, 0.25, 1) both;
}

.hero-copy > * {
  animation: rise-in 680ms cubic-bezier(0.2, 0.75, 0.25, 1) both;
}

.hero-copy > :nth-child(2) {
  animation-delay: 90ms;
}

.hero-copy > :nth-child(3) {
  animation-delay: 170ms;
}

.hero-copy > :nth-child(4) {
  animation-delay: 250ms;
}

.hero-card {
  animation: hero-card-in 760ms 160ms cubic-bezier(0.2, 0.75, 0.25, 1) both,
    gentle-float 6s 1s ease-in-out infinite;
}

.match-track span {
  transform-origin: left;
  animation: progress-in 1.1s 450ms cubic-bezier(0.2, 0.75, 0.25, 1) both;
}

.auth-shell {
  animation: rise-in 620ms cubic-bezier(0.2, 0.75, 0.25, 1) both;
}

.auth-brand-panel::after {
  animation: slow-orbit 28s linear infinite;
}

.page-content {
  animation: rise-in 480ms cubic-bezier(0.2, 0.75, 0.25, 1) both;
}

.panel,
.job-card,
.stat-card {
  transition: transform 220ms ease, box-shadow 220ms ease, border-color 220ms ease;
}

.job-card:hover,
.stat-card:hover {
  transform: translateY(-4px);
  box-shadow: 0 20px 44px rgba(15, 23, 42, 0.12);
}

.panel:focus-within {
  border-color: rgba(99, 102, 241, 0.42);
}

.button:active:not(:disabled) {
  transform: translateY(0) scale(0.98);
}

input,
textarea,
select {
  transition: border-color 160ms ease, box-shadow 160ms ease;
}

input:focus,
textarea:focus,
select:focus {
  border-color: #6366f1;
  outline: 0;
  box-shadow: 0 0 0 3px rgba(99, 102, 241, 0.14);
}

.loading-message {
  animation: soft-pulse 1.8s ease-in-out infinite;
}

@keyframes rise-in {
  from {
    opacity: 0;
    transform: translateY(18px);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

@keyframes slide-down {
  from {
    opacity: 0;
    transform: translateY(-10px);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

@keyframes hero-card-in {
  from {
    opacity: 0;
    transform: translateY(18px) rotate(1deg);
  }
  to {
    opacity: 1;
    transform: rotate(1deg);
  }
}

@keyframes gentle-float {
  0%, 100% {
    translate: 0 0;
  }
  50% {
    translate: 0 -7px;
  }
}

@keyframes progress-in {
  from {
    transform: scaleX(0);
  }
  to {
    transform: scaleX(1);
  }
}

@keyframes slow-orbit {
  to {
    rotate: 360deg;
  }
}

@keyframes soft-pulse {
  0%, 100% {
    box-shadow: 0 0 0 0 rgba(79, 70, 229, 0);
  }
  50% {
    box-shadow: 0 0 0 5px rgba(79, 70, 229, 0.06);
  }
}

@keyframes empty-state-in {
  from {
    opacity: 0;
    transform: translateY(14px) scale(0.985);
  }
  to {
    opacity: 1;
    transform: translateY(0) scale(1);
  }
}

@keyframes empty-icon-float {
  0%, 100% {
    transform: translateY(0);
  }
  50% {
    transform: translateY(-5px);
  }
}

@media (prefers-reduced-motion: reduce) {
  *,
  *::before,
  *::after {
    scroll-behavior: auto !important;
    animation-duration: 0.01ms !important;
    animation-iteration-count: 1 !important;
    transition-duration: 0.01ms !important;
  }
}

@media (max-width: 760px) {
  .navbar {
    height: auto;
    gap: 16px;
    padding: 16px 5vw;
  }

  .nav-links {
    gap: 10px;
  }

  .page-content {
    margin: 32px auto;
  }

  .search-bar {
    grid-template-columns: 1fr;
  }

  .search-bar .button {
    width: 100%;
  }

  .job-grid,
  .dashboard-grid {
    grid-template-columns: 1fr;
  }

  .dashboard-grid section {
    padding: 22px;
  }

  .profile-form,
  .stats-grid {
    grid-template-columns: 1fr;
  }

  .applicant-row,
  .admin-row,
  .application-row {
    grid-template-columns: 1fr;
  }

  .application-row {
    align-items: stretch;
    flex-direction: column;
  }

  .pagination {
    flex-wrap: wrap;
  }

  .admin-row select {
    width: 100%;
  }

  
  .nav-links a:not(.button) {
    display: none;
  }

  .hero {
    grid-template-columns: 1fr;
    min-height: auto;
    padding: 52px 6vw;
  }

  .hero-actions {
    align-items: stretch;
    flex-direction: column;
  }

  .auth-page {
    align-items: start;
    padding: 20px 16px;
  }

  .auth-shell {
    min-height: 0;
    grid-template-columns: 1fr;
    border-radius: 20px;
  }

  .auth-brand-panel {
    min-height: 250px;
    padding: 28px;
  }

  .auth-brand-panel h2 {
    font-size: 2rem;
  }

  .auth-trust {
    display: none;
  }

  .auth-card {
    padding: 34px 24px;
  }

  .hero h1 {
    font-size: 3rem;
  }

  .hero-card {
    transform: none;
    padding: 24px;
    animation-name: rise-in, gentle-float;
  }
}

.workspace-shell {
  grid-template-columns: 220px minmax(0, 1fr);
  align-items: start;
  gap: 22px;
}

.workspace-sidebar {
  position: sticky;
  top: 94px;
  display: grid;
  align-content: start;
  gap: 8px;
  padding: 16px;
  border: 1px solid rgba(255, 255, 255, 0.8);
  border-radius: 20px;
  background: rgba(255, 255, 255, 0.65);
  box-shadow: 0 16px 42px rgba(57, 48, 96, 0.08);
  backdrop-filter: blur(18px);
}

.workspace-sidebar > a {
  padding: 11px 12px;
  border-radius: 11px;
  color: #625e78;
  font-weight: 700;
  transition: color 160ms ease, background 160ms ease, transform 160ms ease;
}

.workspace-sidebar > a:hover {
  color: #5040b5;
  background: rgba(237, 233, 254, 0.8);
  transform: translateX(2px);
}

.workspace-sidebar > a.active {
  color: white;
  background: linear-gradient(110deg, #7666dc, #9b79d7);
  box-shadow: 0 7px 18px rgba(111, 92, 190, 0.22);
}

.workspace-main {
  display: grid;
  min-width: 0;
  gap: 20px;
}

.application-progress {
  display: flex;
  align-items: center;
  gap: 0;
  max-width: 620px;
  margin: 14px 0 8px;
}

.progress-step {
  position: relative;
  display: flex;
  flex: 1 1 0;
  flex-direction: column;
  align-items: center;
  gap: 6px;
  min-width: 58px;
  color: #9994aa;
  font-size: 0.67rem;
  text-align: center;
}

.progress-step:not(:last-of-type)::after {
  content: "";
  position: absolute;
  top: 5px;
  left: calc(50% + 7px);
  width: calc(100% - 14px);
  height: 2px;
  background: #e8e4f1;
}

.progress-step.is-complete {
  color: #6154a9;
  font-weight: 750;
}

.progress-step.is-complete:not(:last-of-type)::after {
  background: linear-gradient(90deg, #8b78df, #d7cdf8);
}

.progress-dot {
  z-index: 1;
  width: 11px;
  height: 11px;
  border: 2px solid #dcd7e9;
  border-radius: 50%;
  background: #fff;
}

.progress-step.is-complete .progress-dot {
  border-color: #7866d1;
  background: #7866d1;
  box-shadow: 0 0 0 3px rgba(120, 102, 209, 0.12);
}

.pipeline-board {
  display: grid;
  grid-auto-columns: minmax(190px, 1fr);
  grid-auto-flow: column;
  gap: 12px;
  overflow-x: auto;
  padding: 4px 2px 12px;
  scroll-snap-type: x proximity;
}

.pipeline-column {
  display: grid;
  align-content: start;
  gap: 10px;
  min-height: 210px;
  padding: 12px;
  border: 1px solid rgba(131, 118, 167, 0.12);
  border-radius: 15px;
  background: rgba(245, 242, 253, 0.62);
  scroll-snap-align: start;
}

.pipeline-column-heading {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 8px;
  padding-bottom: 10px;
  border-bottom: 1px solid rgba(131, 118, 167, 0.12);
  color: #514a6b;
  font-size: 0.82rem;
}

.pipeline-column-heading span {
  display: grid;
  min-width: 24px;
  height: 24px;
  place-items: center;
  border-radius: 999px;
  color: #6558a8;
  background: #ebe6fb;
  font-size: 0.7rem;
  font-weight: 800;
}

.pipeline-card {
  display: grid;
  gap: 7px;
  padding: 12px;
  border: 1px solid rgba(255, 255, 255, 0.9);
  border-radius: 12px;
  background: rgba(255, 255, 255, 0.86);
  box-shadow: 0 7px 18px rgba(57, 48, 96, 0.06);
  animation: rise-in 360ms ease both;
}

.pipeline-card strong {
  color: #39344e;
  font-size: 0.8rem;
}

.pipeline-card > span {
  color: #858096;
  font-size: 0.72rem;
}

.pipeline-card select {
  padding: 7px 8px;
  font-size: 0.72rem;
}

.pipeline-empty {
  padding: 12px 4px;
  color: #9994aa;
  font-size: 0.72rem;
  text-align: center;
}

.recruiter-stats {
  grid-template-columns: repeat(4, minmax(0, 1fr));
}

.admin-table .button:disabled {
  cursor: not-allowed;
  opacity: 0.45;
}

@media (max-width: 900px) {
  .workspace-shell {
    grid-template-columns: 1fr;
  }

  .workspace-sidebar {
    position: static;
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }

  .workspace-sidebar .admin-identity {
    grid-column: 1 / -1;
  }

  .workspace-main {
    grid-column: 1;
  }

  .recruiter-stats {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
}

@media (max-width: 760px) {
  .workspace-sidebar {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .workspace-sidebar > a {
    padding: 9px;
    font-size: 0.82rem;
  }

  .application-progress {
    overflow-x: auto;
    padding-bottom: 4px;
  }
}

:root {
  color: #24213a;
  background: #f7f5ff;
}

body {
  background: linear-gradient(135deg, #f8f6ff, #f1f8ff 48%, #fff5fa);
  background-attachment: fixed;
}

body::before {
  content: "";
  position: fixed;
  inset: -35%;
  z-index: -1;
  pointer-events: none;
  background:
    radial-gradient(ellipse at 18% 20%, rgba(196, 181, 253, 0.3), transparent 35%),
    radial-gradient(ellipse at 80% 28%, rgba(125, 211, 252, 0.22), transparent 32%),
    radial-gradient(ellipse at 64% 82%, rgba(249, 168, 212, 0.2), transparent 34%),
    radial-gradient(ellipse at 25% 80%, rgba(167, 243, 208, 0.18), transparent 28%);
  filter: blur(28px);
  animation: ambient-drift 22s ease-in-out infinite alternate;
}

.navbar {
  position: sticky;
  top: 0;
  background: rgba(255, 255, 255, 0.76);
  border-bottom-color: rgba(255, 255, 255, 0.72);
  box-shadow: 0 8px 32px rgba(58, 45, 99, 0.06);
  backdrop-filter: blur(18px);
}

.brand {
  letter-spacing: -0.04em;
}

.hero {
  background:
    radial-gradient(circle at 82% 18%, rgba(196, 181, 253, 0.3), transparent 28%),
    radial-gradient(circle at 10% 90%, rgba(110, 231, 183, 0.18), transparent 24%),
    linear-gradient(135deg, rgba(255, 255, 255, 0.72), rgba(241, 238, 255, 0.76) 58%, rgba(232, 245, 255, 0.78));
}

.hero-card {
  border: 1px solid rgba(255, 255, 255, 0.24);
  background: linear-gradient(145deg, rgba(40, 35, 83, 0.9), rgba(77, 65, 143, 0.84));
  backdrop-filter: blur(20px);
}

.page-content {
  width: min(1240px, 94%);
  margin: 42px auto;
}

.panel,
.auth-shell,
.resume-selector {
  border: 1px solid rgba(255, 255, 255, 0.76);
  background: rgba(255, 255, 255, 0.68);
  box-shadow: 0 18px 54px rgba(57, 48, 96, 0.09);
  backdrop-filter: blur(18px);
}

.job-card,
.admin-table-panel,
.analytics-panel {
  border-radius: 20px;
}

.search-bar {
  padding: 18px;
  border: 1px solid rgba(255, 255, 255, 0.8);
  border-radius: 20px;
  background: rgba(255, 255, 255, 0.58);
  box-shadow: 0 14px 40px rgba(57, 48, 96, 0.07);
  backdrop-filter: blur(16px);
}

.job-card {
  border-color: rgba(255, 255, 255, 0.84);
  background: rgba(255, 255, 255, 0.74);
}

.job-company {
  display: flex;
  align-items: center;
  gap: 10px;
}

.company-avatar {
  display: grid;
  flex: 0 0 auto;
  width: 38px;
  height: 38px;
  place-items: center;
  border: 1px solid rgba(123, 108, 189, 0.12);
  border-radius: 12px;
  color: #6655bb;
  background: linear-gradient(145deg, #eee9ff, #dff3ff);
  font-weight: 850;
}

.job-company > div {
  display: grid;
  gap: 3px;
}

.job-company strong {
  color: #48435d;
  font-size: 0.9rem;
}

.job-company span:not(.company-avatar),
.job-posted {
  color: #89849a;
  font-size: 0.8rem;
}

.auth-shell {
  background: rgba(255, 255, 255, 0.7);
}

.auth-card {
  background: rgba(255, 255, 255, 0.45);
}

.admin-shell {
  grid-template-columns: 220px minmax(0, 1fr);
  align-items: start;
  gap: 22px;
}

.admin-sidebar {
  position: sticky;
  top: 94px;
  display: grid;
  gap: 8px;
  padding: 16px;
  border: 1px solid rgba(255, 255, 255, 0.8);
  border-radius: 20px;
  background: rgba(255, 255, 255, 0.65);
  box-shadow: 0 16px 42px rgba(57, 48, 96, 0.08);
  backdrop-filter: blur(18px);
}

.admin-sidebar > a,
.admin-logout {
  padding: 11px 12px;
  border: 0;
  border-radius: 11px;
  color: #625e78;
  background: transparent;
  text-align: left;
  font: inherit;
  font-weight: 700;
  cursor: pointer;
  transition: color 160ms ease, background 160ms ease, transform 160ms ease;
}

.admin-sidebar > a:hover,
.admin-logout:hover {
  color: #5040b5;
  background: rgba(237, 233, 254, 0.8);
  transform: translateX(2px);
}

.admin-sidebar > a.active {
  color: #fff;
  background: linear-gradient(110deg, #7666dc, #9b79d7);
  box-shadow: 0 7px 18px rgba(111, 92, 190, 0.22);
}

.admin-identity {
  display: flex;
  align-items: center;
  gap: 11px;
  margin-bottom: 10px;
  padding: 10px 4px 16px;
  border-bottom: 1px solid rgba(111, 103, 140, 0.12);
}

.admin-identity > div {
  display: grid;
  gap: 3px;
  min-width: 0;
}

.admin-identity strong {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.admin-identity span:last-child {
  color: #817c97;
  font-size: 0.8rem;
}

.admin-avatar,
.stat-icon {
  display: grid;
  flex: 0 0 auto;
  width: 40px;
  height: 40px;
  place-items: center;
  border-radius: 13px;
  color: #594bb4;
  background: linear-gradient(145deg, #eee9ff, #dff3ff);
  font-weight: 800;
}

.admin-logout {
  margin-top: 8px;
  color: #b34c78;
  background: rgba(255, 237, 244, 0.66);
}

.admin-main {
  display: grid;
  min-width: 0;
  gap: 20px;
}

.admin-overview {
  display: grid;
  gap: 16px;
}

.section-heading {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16px;
  margin-bottom: 16px;
}

.section-heading h2 {
  margin: 5px 0 0;
  color: #302b4d;
  font-size: 1.32rem;
  letter-spacing: -0.025em;
}

.live-indicator,
.chart-total,
.table-count {
  padding: 7px 11px;
  border: 1px solid rgba(123, 108, 189, 0.14);
  border-radius: 999px;
  color: #6257a2;
  background: rgba(244, 241, 255, 0.76);
  font-size: 0.78rem;
  font-weight: 750;
  white-space: nowrap;
}

.live-indicator::before {
  content: "";
  display: inline-block;
  width: 7px;
  height: 7px;
  margin-right: 7px;
  border-radius: 50%;
  background: #34c58b;
  box-shadow: 0 0 0 3px rgba(52, 197, 139, 0.13);
}

.stats-grid {
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 12px;
}

.stat-card {
  position: relative;
  overflow: hidden;
  grid-template-columns: 42px 1fr;
  align-items: center;
  gap: 2px 12px;
  padding: 17px;
  border: 1px solid rgba(255, 255, 255, 0.85);
  background: linear-gradient(135deg, rgba(255, 255, 255, 0.86), rgba(244, 240, 255, 0.72));
  box-shadow: 0 10px 28px rgba(57, 48, 96, 0.06);
  text-align: left;
  animation: rise-in 500ms both;
}

.stat-card:nth-child(2) { animation-delay: 50ms; }
.stat-card:nth-child(3) { animation-delay: 100ms; }
.stat-card:nth-child(4) { animation-delay: 150ms; }
.stat-card:nth-child(5) { animation-delay: 200ms; }
.stat-card:nth-child(6) { animation-delay: 250ms; }

.stat-card .stat-icon {
  grid-row: span 2;
}

.stat-card strong {
  color: #373052;
  font-size: 1.6rem;
  line-height: 1.15;
}

.stat-card > span:last-child {
  color: #77718d;
  font-size: 0.8rem;
  font-weight: 650;
}

.stat-card-2 .stat-icon { color: #178a91; background: linear-gradient(145deg, #dcfbf5, #ddf5ff); }
.stat-card-3 .stat-icon { color: #a64f88; background: linear-gradient(145deg, #ffe5f2, #f3e5ff); }
.stat-card-4 .stat-icon { color: #c17a31; background: linear-gradient(145deg, #fff1d9, #ffe7ef); }
.stat-card-5 .stat-icon { color: #258b68; background: linear-gradient(145deg, #dcfae9, #e5f8ff); }
.stat-card-6 .stat-icon { color: #4a71b3; background: linear-gradient(145deg, #e4efff, #f0e9ff); }

.analytics-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 14px;
}

.analytics-panel {
  min-width: 0;
  padding: 20px !important;
}

.analytics-panel .section-heading {
  margin-bottom: 4px;
}

.analytics-panel .section-heading h2 {
  font-size: 1.05rem;
}

.chart-bars {
  display: grid;
  grid-template-columns: repeat(14, minmax(12px, 1fr));
  align-items: end;
  gap: 5px;
  height: 148px;
  padding: 14px 2px 0;
}

.chart-bar-group {
  display: grid;
  grid-template-rows: 18px 1fr 18px;
  justify-items: center;
  align-items: end;
  height: 100%;
  min-width: 0;
}

.chart-value,
.chart-date {
  color: #918ca6;
  font-size: 0.61rem;
  line-height: 1;
}

.chart-value {
  align-self: center;
  color: #635b85;
  font-weight: 700;
}

.chart-bar {
  align-self: end;
  width: min(100%, 16px);
  height: var(--bar-height);
  min-height: 3px;
  border-radius: 6px 6px 2px 2px;
  background: linear-gradient(180deg, #a994ed, #7968d8);
  transform-origin: bottom;
  animation: chart-grow 700ms cubic-bezier(0.2, 0.75, 0.25, 1) both;
  transition: filter 160ms ease;
}

.chart-mint .chart-bar {
  background: linear-gradient(180deg, #7be0bd, #45af9a);
}

.chart-bar-group:hover .chart-bar {
  filter: saturate(1.35) brightness(1.04);
}

.chart-date {
  align-self: end;
  font-size: 0.56rem;
}

.admin-table-panel {
  min-width: 0;
  padding: 24px !important;
  scroll-margin-top: 96px;
}

.admin-filters {
  display: grid;
  grid-template-columns: minmax(180px, 1.5fr) repeat(2, minmax(150px, 1fr));
  gap: 10px;
  margin-bottom: 14px;
}

.admin-filters input,
.admin-filters select,
.admin-table select {
  padding: 10px 12px;
  border-color: rgba(132, 122, 161, 0.2);
  border-radius: 11px;
  background: rgba(255, 255, 255, 0.78);
}

.admin-table-wrap {
  overflow-x: auto;
  border: 1px solid rgba(129, 119, 156, 0.12);
  border-radius: 14px;
}

.admin-table {
  width: 100%;
  border-collapse: collapse;
  text-align: left;
}

.admin-table th {
  padding: 12px 14px;
  color: #77718d;
  background: rgba(245, 242, 252, 0.72);
  font-size: 0.72rem;
  letter-spacing: 0.045em;
  text-transform: uppercase;
}

.admin-table td {
  padding: 12px 14px;
  border-top: 1px solid rgba(129, 119, 156, 0.1);
  color: #514d63;
  font-size: 0.86rem;
}

.admin-table tbody tr {
  transition: background 150ms ease;
}

.admin-table tbody tr:hover {
  background: rgba(247, 244, 255, 0.8);
}

.admin-table td:first-child {
  min-width: 135px;
}

.admin-table td:first-child strong,
.admin-table td:first-child span {
  display: block;
}

.admin-table td:first-child span {
  margin-top: 4px;
  color: #8a859b;
  font-size: 0.75rem;
}

.admin-table .button {
  padding: 8px 11px;
  font-size: 0.76rem;
}

.table-status,
.role-pill {
  display: inline-flex;
  padding: 5px 9px;
  border-radius: 999px;
  color: #685b9c;
  background: #f0ebff;
  font-size: 0.72rem;
  font-weight: 750;
  text-transform: capitalize;
}

.status-active,
.status-published {
  color: #147656;
  background: #e2f8ee;
}

.status-disabled,
.status-rejected {
  color: #a64267;
  background: #ffedf3;
}

.status-pending {
  color: #a26720;
  background: #fff4dc;
}

.status-closed,
.status-draft {
  color: #656176;
  background: #eeedf3;
}

.table-empty {
  padding: 30px !important;
  color: #858096 !important;
  text-align: center;
}

.table-pagination {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 9px;
  margin-top: 14px;
}

.table-pagination span {
  margin-right: auto;
  color: #77718d;
  font-size: 0.82rem;
}

@keyframes ambient-drift {
  from { transform: translate3d(-1.5%, -1%, 0) rotate(0); }
  to { transform: translate3d(1.5%, 1%, 0) rotate(5deg); }
}

@keyframes chart-grow {
  from { transform: scaleY(0.08); opacity: 0.45; }
  to { transform: scaleY(1); opacity: 1; }
}

@media (max-width: 900px) {
  .admin-shell {
    grid-template-columns: 1fr;
  }

  .admin-sidebar {
    position: static;
    grid-template-columns: repeat(5, auto);
    align-items: center;
  }

  .admin-identity {
    grid-column: 1 / -1;
  }

  .admin-main {
    grid-column: 1;
  }
}

@media (max-width: 760px) {
  .analytics-grid {
    grid-template-columns: 1fr;
  }

  .stats-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .admin-sidebar {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .admin-sidebar > a,
  .admin-logout {
    padding: 9px;
    font-size: 0.82rem;
  }

  .admin-filters {
    grid-template-columns: 1fr;
  }

  .admin-table-wrap {
    overflow: visible;
    border: 0;
  }

  .admin-table thead {
    display: none;
  }

  .admin-table,
  .admin-table tbody,
  .admin-table tr,
  .admin-table td {
    display: block;
    width: 100%;
  }

  .admin-table tr {
    margin-bottom: 10px;
    overflow: hidden;
    border: 1px solid rgba(129, 119, 156, 0.12);
    border-radius: 12px;
    background: rgba(255, 255, 255, 0.56);
  }

  .admin-table td {
    display: grid;
    grid-template-columns: 110px minmax(0, 1fr);
    align-items: center;
    gap: 8px;
    padding: 10px 12px;
    border-top: 1px solid rgba(129, 119, 156, 0.08);
    overflow-wrap: anywhere;
  }

  .admin-table td::before {
    content: attr(data-label);
    color: #8a859b;
    font-size: 0.68rem;
    font-weight: 750;
    text-transform: uppercase;
  }

  .admin-table td.table-empty {
    display: block;
  }

  .admin-table td.table-empty::before {
    content: none;
  }

  .admin-table td select {
    width: 100%;
  }

  .admin-table-panel {
    padding: 18px !important;
  }
}
